rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authentication helper
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles (Owner isolated)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /crops/{cropId} {
        allow read, write: if isOwner(userId);

        match /conversations/{conversationId} {
          allow read, write: if isOwner(userId);

          match /messages/{messageId} {
            allow read, write: if isOwner(userId);
          }
        }
      }

      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId);
        allow create, delete: if false;
      }
    }

    // Private farm metadata (Coordinates kept strictly private)
    match /farms/{farmId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Crop Cycles
    match /cropCycles/{cycleId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Health records and diagnoses (Owner only)
    match /cropHealthRecords/{recordId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /diagnoses/{diagnosisId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Reference pesticide catalog (Public read-only, write protected)
    match /pesticideProducts/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Anonymized community outbreak reports (Public read, authenticated create)
    // Enforces anonymousReporterId and ensures no farmer phone/name is present
    match /diseaseReports/{reportId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.anonymousReporterId != null &&
        request.resource.data.approximateLocation != null;
      allow update, delete: if false; // Immutable audit trail
    }

    // Notifications (User private)
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false; // Cloud Functions only
    }
  }
}
