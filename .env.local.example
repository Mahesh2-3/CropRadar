# Copy to .env.local for local development. Use Vercel Environment Variables in production.

# Google AI Studio (server-only). Leave unset to disable Gemini features.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# Firebase Web App configuration (public values; restrict the API key in Google Cloud).
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-app-id

# Firebase Admin service account (server-only; do not use a committed JSON key file).
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=service-account-email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional: comma-separated Firebase Auth UIDs authorized to review outbreak reports.
AGRONOMIST_UIDS=

# Optional: enables persistent image uploads. Image analysis works without Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
